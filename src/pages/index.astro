---
import "../styles/global.css";
import { snowflakeMarkup, VIEWBOX } from "../lib/render";
import { HISTORY_LIMIT, HISTORY_TTL } from "../lib/history";
import { generateSnowflake } from "../lib/snowflake";

const initialInput = "hello world";
// 公開先のパス（astro.config.mjs の base）。末尾を "/" にそろえてから各ファイル名をつなげる
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// 初期表示用にビルド時に同じロジックで生成しておく（JS 実行後は同じ結晶を成長アニメーションで描き直す）
const { snowflake } = await generateSnowflake(initialInput);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="文字列の SHA-256 から、固有の雪の結晶を生成します。" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Hash Snowflake</title>
    <noscript><style>[data-stage][data-state="pending"] { opacity: 1; }</style></noscript>
  </head>
  <body>
    <div class="diamond-dust" data-diamond-dust aria-hidden="true"></div>
    <div class="diamond-dust-twinkle" data-diamond-twinkle aria-hidden="true"></div>
    <div class="snowfall" data-snowfall aria-hidden="true"></div>

    <button class="corner-button history-toggle" type="button" popovertarget="history-panel" aria-label="生成履歴を開く">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5"></circle>
        <path d="M12 7.5V12l3 2"></path>
      </svg>
    </button>
    <section class="history-panel" id="history-panel" popover aria-labelledby="history-title">
      <h2 class="history-title" id="history-title">最近の結晶</h2>
      <ol class="history-list" data-history-list></ol>
      <p class="history-empty" data-history-empty>まだ履歴はありません。</p>
      <p class="history-note">最大 {HISTORY_LIMIT} 件・{HISTORY_TTL / 3600000} 時間でこのブラウザから消えます。</p>
    </section>
    <main class="page">
      <header class="intro">
        <h1 class="title">Hash Snowflake</h1>
        <p class="lead">
          入力した文字列のハッシュ値をもとに、雪の結晶を生成します。
        </p>
      </header>

      <form class="controls" id="snowflake-form" data-form>
        <label class="visually-hidden" for="seed-input">雪の結晶のもとになる文字列</label>
        <div class="seed-field">
          <input
            class="seed-input"
            id="seed-input"
            name="text"
            type="text"
            value={initialInput}
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="go"
            data-input
          />
        </div>
        <div class="actions">
          <button class="generate" type="submit" data-generate>
            <span class="generate-idle">Generate</span>
            <span class="generate-busy">Loading…</span>
          </button>
          <button class="download" type="button" data-download disabled>
            <span>SVG</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v10m0 0-4-4m4 4 4-4M5.5 19.5h13"></path></svg>
          </button>
        </div>
      </form>

      <div class="stage" data-stage data-state="pending">
        <svg class="flake" viewBox={VIEWBOX} role="img" aria-label={`「${initialInput}」から生成した雪の結晶`}>
          <defs>
            <radialGradient id="core-glow">
              <stop offset="0" stop-color="#dbeeff" stop-opacity="0.32"></stop>
              <stop offset="1" stop-color="#dbeeff" stop-opacity="0"></stop>
            </radialGradient>
            <filter id="soft-glow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="1.1" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>
          <g data-flake-root set:html={snowflakeMarkup(snowflake)} />
        </svg>
      </div>
    </main>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
